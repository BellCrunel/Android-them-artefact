# ЦЕ ШАБЛОН. Сюди пароль НЕ вписувати — цей файл іде в git.
#
# Зробіть КОПІЮ поруч і назвіть її keystore.properties (без .example).
# Пароль вписуйте вже туди: keystore.properties у .gitignore,
# у репозиторій він не потрапить.
#
# Ключ створює MAKE-KEY.bat. Пароль там питає keytool.
#
# ВАЖЛИВО: збережіть і файл ключа, і пароль. Без них наступна версія
# застосунку не встановиться поверх старої — тільки поруч, з нуля.

storeFile=artefact-release.jks
storePassword=ВАШ_ПАРОЛЬ
keyAlias=artefact
keyPassword=ВАШ_ПАРОЛЬ
