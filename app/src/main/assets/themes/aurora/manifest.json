{
  "formatVersion": 2,
  "id": "builtin.aurora",
  "name": "Aurora",
  "author": "Bell Launcher",
  "version": "2.0.0",
  "description": "Темна нічна тема: великі цифри, м'які квадратні підкладки під іконками.",

  "wallpaper": {
    "gradient": ["#0A0A0F", "#141420", "#0D1520", "#07070C"],
    "dim": 0.0,
    "parallaxOnScroll": true
  },

  "colors": {
    "dark": true,
    "primary": "#B9B9C7",
    "onPrimary": "#101018",
    "secondary": "#8FA8C8",
    "background": "#0A0A0F",
    "onBackground": "#EDEDF2",
    "surface": "#17171F",
    "onSurface": "#EDEDF2",
    "outline": "#2AFFFFFF",
    "homeLabel": "#FFFFFF",
    "drawerLabel": "#EDEDF2",
    "labelShadow": "#99000000",
    "scrubber": "#FFFFFF"
  },

  "typography": {
    "scale": 1.0,
    "allCaps": false
  },

  "header": {
    "style": "bigDigits",
    "clockSizeSp": 82,
    "clockWeight": 700,
    "clockLetterSpacingEm": -0.06,
    "clockSeparator": "",
    "hour24": true,
    "dateFormat": "EEE, d MMM",
    "showDate": true,
    "showWeather": true,
    "subSeparator": "  ",
    "subSizeSp": 15,
    "align": "start",
    "paddingTopDp": 104,
    "paddingBottomDp": 30
  },

  "icons": {
    "shape": "rounded",
    "cornerRadiusPercent": 30,
    "scale": 0.62,
    "background": "#1E1E28",
    "tint": "#E6E6EE",
    "normalizeLegacyIcons": true
  },

  "layout": {
    "iconSizeDp": 44,
    "rowSpacingDp": 12,
    "iconGapDp": 20,
    "horizontalPaddingDp": 26,
    "align": "start",
    "showIcons": true,
    "labelSizeSp": 17,
    "labelWeight": 500,
    "drawerScrubber": true,
    "drawerShowIcons": true
  },

  "effects": {
    "drawerScrim": 0.9,
    "animationSpeed": 1.0,
    "parallax": 0.3
  }
}
